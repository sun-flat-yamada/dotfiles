{
  "editor.fontFamily": "'HackGen Console NF', 'HackGen Console NF Regular', 'Hack Nerd Font Mono', Consolas, 'Courier New', monospace",
  "editor.lineNumbers": "on",
  "editor.tabSize": 2,
  "window.title": "${dirty}${activeEditorShort} / ${rootName}",
  "workbench.list.smoothScrolling": false,
  "window.openFoldersInNewWindow": "on",
  "window.closeWhenEmpty": false,
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.colorCustomizations": {
    "window.activeBorder": "#a94dc1",
    "window.inactiveBorder": "#591d61",
    "activityBar.border": "#a94dc1",
    "activityBar.background": "#190821",
    "titleBar.border": "#a94dc1",
    "editorGroupHeader.tabsBorder": "#a94dc1",
    "tab.activeBackground": "#5332a0",
    "tab.border": "#430f7e",
    "editorIndentGuide.activeBackground1": "#430f7e",
    "editorIndentGuide.background1": "#3a383a",
    "editorBracketMatch.background": "#430f7e",
    "editorBracketMatch.border": "#ffffff",
    "editor.wordHighlightStrongBackground": "#740ee9f8",
    "editor.wordHighlightBorder": "#740ee9f8",
    "editor.rangeHighlightBackground": "#740ee9f8",
    "editor.rangeHighlightBorder": "#740ee9f8",
    "editor.selectionBackground": "#c7c7c76b",
    "editor.selectionHighlightBorder": "#ffffff",
    "terminal.ansiBlack": "#171c2a",
    "terminal.ansiRed": "#E35535",
    "terminal.ansiGreen": "#52AB62",
    "terminal.ansiYellow": "#ffd866",
    "terminal.ansiBlue": "#00B3BD",
    "terminal.ansiMagenta": "#e991e3",
    "terminal.ansiCyan": "#78e8c6",
    "terminal.ansiWhite": "#FFFFFFcc",
    "terminal.ansiBrightBlack": "#5c6d74",
    "terminal.ansiBrightRed": "#E35535",
    "terminal.ansiBrightGreen": "#52AB62",
    "terminal.ansiBrightYellow": "#ffd866",
    "terminal.ansiBrightBlue": "#00B3BD",
    "terminal.ansiBrightMagenta": "#e991e3",
    "terminal.ansiBrightCyan": "#78e8c6",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminal.background": "#171c2a",
    "terminal.foreground": "#ffffff",
    "terminal.selectionBackground": "#5332a0",
    "terminalCursor.background": "#171c2a",
    "terminalCursor.foreground": "#ffd866"
  },
  "explorer.excludeGitIgnore": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.confirmDelete": true,
  "workbench.editor.tabSizing": "shrink",
  "window.density.editorTabHeight": "compact",
  "workbench.editor.wrapTabs": false,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.scrollToSwitchTabs": true,
  "workbench.view.alwaysShowHeaderActions": true,
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.dragAndDrop": false,
  "editor.minimap.maxColumn": 80,
  "editor.minimap.showSlider": "always",
  "editor.mouseWheelZoom": true,
  "editor.renderLineHighlight": "all",
  "editor.renderWhitespace": "all",
  "editor.showFoldingControls": "always",
  "editor.smoothScrolling": true,
  "editor.wordSegmenterLocales": [
    "ja"
  ],
  "editor.wrappingIndent": "deepIndent",
  "files.autoGuessEncoding": true,
  "files.candidateGuessEncodings": [
    "utf8",
    "shiftjis",
    "eucjp"
  ],
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 60000,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "editor.formatOnSave": false,
  "search.showLineNumbers": true,
  "diffEditor.experimental.useTrueInlineView": true,
  "git.autofetch": true,
  "git.pruneOnFetch": true,
  "git.suggestSmartCommit": false,
  "git.confirmSync": true,
  "scm.alwaysShowRepositories": true,
  "scm.compactFolders": true,
  "scm.defaultViewMode": "tree",
  "scm.diffDecorationsGutterWidth": 5,
  "scm.graph.badges": "all",
  "scm.inputFontFamily": "editor",
  "scm.inputFontSize": 12,
  "glassit.alpha": 255,
  "glassit.step": 1,
  "github.copilot.chat.byok.ollamaEndpoint": "http://localhost:11434",
  "chat.tools.global.autoApprove": false,
  "chat.agent.sandbox.enabled": "on",
  "chat.agent.sandbox.allowNetwork": false,
  "chat.useClaudeHooks": true,
  "chat.hookFilesLocations": {
    ".github/hooks": true,
    ".claude/settings.local.json": true,
    ".claude/settings.json": true,
    "~/.copilot/hooks": true,
    "~/.claude/settings.json": true,
    "~/.agents/hooks": true
  },
  "windowsaistudio.openAIInferencePort": 11435,
  "docker.extension.enableComposeLanguageServer": false,
  "makefile.configureOnOpen": true
}
