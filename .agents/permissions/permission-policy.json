{
  "version": 1,
  "description": "Canonical, tool-neutral AI agent permission definition. The prose policy is .agents/rules/permission-rules-general.md. Edit this file, then run `python scripts/sync-permissions.py --write` to regenerate every tool-specific file.",
  "syntax": {
    "effect": "allow | ask | deny. deny beats ask beats allow.",
    "shell / powershell": "Command globs: `*` matches any text; a trailing ` *` also matches the bare command.",
    "command_regex": "Regular expressions over one command, for tools that match commands by regex.",
    "read / write / read_except": "Path globs: `~/x` is under the home directory, `/x` is absolute, `**/x` matches at any depth, `./x` or a bare `x` is relative to the workspace root.",
    "fetch / network / domains": "Host names (`*.` prefix for subdomains): `fetch` for the fetch tool, `network` for sandboxed commands, `domains` for both.",
    "web_search": "true when the rule covers the built-in web search tool.",
    "native": "Rules that exist in one tool only, keyed by tool name, written in that tool's own syntax (strings for claude and cursor, rule tables for codex and gemini)."
  },
  "rules": [
    {
      "id": "A-01",
      "effect": "allow",
      "summary": "Read and search workspace files",
      "native": {
        "cursor": [
          "Read(**)"
        ]
      }
    },
    {
      "id": "A-02",
      "effect": "allow",
      "summary": "Read-only inspection commands",
      "command_regex": [
        "^git (status|diff|log|show|blame)\\b(?!.*--(output|ext-diff|textconv))"
      ],
      "native": {
        "cursor": [
          "Shell(ls)",
          "Shell(pwd)",
          "Shell(git:status*)",
          "Shell(git:diff*)",
          "Shell(git:log*)",
          "Shell(git:show*)",
          "Shell(git:blame*)"
        ],
        "gemini": [
          {
            "toolName": "run_shell_command",
            "commandPrefix": [
              "ls",
              "pwd",
              "cat",
              "head",
              "tail",
              "grep",
              "wc",
              "which",
              "whoami",
              "date"
            ]
          }
        ]
      }
    },
    {
      "id": "A-03",
      "effect": "allow",
      "summary": "Edit ordinary workspace files",
      "write": [
        "./**"
      ],
      "native": {
        "cursor": [
          "Write(src/**)",
          "Write(lib/**)",
          "Write(app/**)",
          "Write(include/**)",
          "Write(cmd/**)",
          "Write(internal/**)",
          "Write(pkg/**)",
          "Write(test/**)",
          "Write(tests/**)",
          "Write(spec/**)",
          "Write(docs/**)"
        ]
      }
    },
    {
      "id": "A-04",
      "effect": "allow",
      "summary": "Web search",
      "web_search": true
    },
    {
      "id": "C-HITL",
      "effect": "ask",
      "summary": "Unresolved or host-management commands (default ask)",
      "shell": [
        "eval *",
        "systemctl *",
        "launchctl *"
      ],
      "powershell": [
        "Start-Process *",
        "Set-ExecutionPolicy *"
      ],
      "command_regex": [
        "^(launchctl|systemctl|Start-Process|Set-ExecutionPolicy)\\b"
      ]
    },
    {
      "id": "C-HITL-01",
      "effect": "ask",
      "summary": "Outward VCS and collaboration",
      "shell": [
        "git push *",
        "git clone *",
        "git submodule add *",
        "git remote add *",
        "git remote set-url *",
        "gh *"
      ],
      "powershell": [
        "git push *",
        "git clone *",
        "gh *"
      ],
      "command_regex": [
        "^git\\b.*\\bpush\\b",
        "^git\\b.*\\b(clone|filter-branch|filter-repo)\\b",
        "^git\\b.*\\b(remote (add|set-url)|submodule add|config --(global|system))\\b"
      ]
    },
    {
      "id": "C-HITL-02",
      "effect": "ask",
      "summary": "Dependency changes",
      "shell": [
        "npm install *",
        "npm i *",
        "npm add *",
        "npm update *",
        "npm uninstall *",
        "npm exec *",
        "npx *",
        "pnpm add *",
        "pnpm update *",
        "pnpm remove *",
        "pnpm dlx *",
        "yarn add *",
        "yarn upgrade *",
        "yarn remove *",
        "yarn dlx *",
        "bun add *",
        "bun update *",
        "bun remove *",
        "bunx *",
        "pip install *",
        "pip3 install *",
        "pip uninstall *",
        "python -m pip *",
        "python3 -m pip *",
        "uv add *",
        "uv remove *",
        "uv pip install *",
        "uv tool install *",
        "uvx *",
        "poetry add *",
        "poetry remove *",
        "pipx *",
        "cargo add *",
        "cargo remove *",
        "cargo install *",
        "cargo update*",
        "go get *",
        "go install *",
        "dotnet add *",
        "dotnet remove *",
        "dotnet tool install *",
        "dart pub add *",
        "dart pub remove *",
        "dart pub upgrade*",
        "flutter pub add *",
        "flutter pub upgrade*",
        "brew install *",
        "choco install *",
        "winget install *",
        "scoop install *"
      ],
      "powershell": [
        "npm install *",
        "npx *",
        "pip install *",
        "uvx *",
        "winget install *",
        "scoop install *",
        "choco install *"
      ],
      "write": [
        "**/package.json",
        "**/package-lock.json",
        "**/npm-shrinkwrap.json",
        "**/pnpm-lock.yaml",
        "**/yarn.lock",
        "**/bun.lock",
        "**/bun.lockb",
        "**/pyproject.toml",
        "**/requirements*.txt",
        "**/uv.lock",
        "**/poetry.lock",
        "**/Pipfile",
        "**/Pipfile.lock",
        "**/setup.py",
        "**/setup.cfg",
        "**/Cargo.toml",
        "**/Cargo.lock",
        "**/go.mod",
        "**/go.sum",
        "**/*.csproj",
        "**/Directory.Packages.props",
        "**/packages.lock.json",
        "**/NuGet.config",
        "**/pubspec.yaml",
        "**/pubspec.lock",
        "**/vcpkg.json",
        "**/conanfile.txt",
        "**/conanfile.py"
      ]
    },
    {
      "id": "C-HITL-03",
      "effect": "ask",
      "summary": "Destructive local operations",
      "shell": [
        "git reset --hard*",
        "git clean *",
        "git restore *",
        "git checkout -- *",
        "git stash drop*",
        "git stash clear*",
        "git branch -D *",
        "git filter-branch *",
        "git filter-repo *",
        "git reflog expire*",
        "git gc --prune=now*",
        "rm -r *",
        "rm -rf *",
        "rm -fr *",
        "rm -R *",
        "rm -Rf *",
        "rm --recursive *",
        "find * -delete*",
        "kill *",
        "pkill *",
        "killall *"
      ],
      "powershell": [
        "git reset --hard*",
        "git clean *",
        "Remove-Item * -Recurse*",
        "Remove-Item -Recurse*",
        "Stop-Process *"
      ],
      "command_regex": [
        "^git\\b.*\\b(reset --hard|clean|restore|checkout --|stash (drop|clear)|branch -D)\\b",
        "^Remove-Item\\b",
        "^rm\\b.*\\s(-[A-Za-z]*[rR]|--recursive)"
      ]
    },
    {
      "id": "C-HITL-04",
      "effect": "ask",
      "summary": "Network access through the shell",
      "shell": [
        "curl *",
        "wget *",
        "ssh *",
        "scp *",
        "sftp *",
        "rsync *",
        "ftp *",
        "nc *",
        "ncat *",
        "netcat *",
        "socat *",
        "telnet *",
        "ping *",
        "dig *",
        "nslookup *",
        "host *"
      ],
      "powershell": [
        "Invoke-WebRequest *",
        "Invoke-RestMethod *",
        "curl *",
        "ssh *",
        "scp *"
      ],
      "command_regex": [
        "^(Invoke-WebRequest|iwr|Invoke-RestMethod|irm)\\b"
      ]
    },
    {
      "id": "C-HITL-05",
      "effect": "ask",
      "summary": "AI, CI, and governance configuration",
      "write": [
        ".claude/**",
        ".codex/**",
        ".cursor/**",
        ".gemini/**",
        ".vscode/**",
        ".agents/**",
        ".github/**",
        ".githooks/**",
        ".pre-commit-config.yaml",
        "CLAUDE.md",
        "AGENTS.md",
        "GEMINI.md",
        ".cursorrules",
        ".gitignore"
      ]
    },
    {
      "id": "C-HITL-06",
      "effect": "ask",
      "summary": "Containers, cloud CLIs, IaC, and database clients",
      "shell": [
        "docker *",
        "podman *",
        "kubectl *",
        "helm *",
        "terraform *",
        "tofu *",
        "terragrunt *",
        "pulumi *",
        "cdk *",
        "aws *",
        "gcloud *",
        "gsutil *",
        "az *",
        "psql *",
        "mysql *",
        "mongosh *",
        "redis-cli *",
        "sqlcmd *"
      ],
      "powershell": [
        "docker *",
        "kubectl *",
        "terraform *",
        "aws *",
        "gcloud *",
        "az *"
      ]
    },
    {
      "id": "C-HITL-07",
      "effect": "ask",
      "summary": "Leaving the sandbox; MCP servers, plugins, and extensions",
      "shell": [
        "claude mcp add*",
        "claude plugin *",
        "codex mcp add*",
        "gemini mcp add*",
        "gemini extensions install*",
        "code --install-extension *",
        "cursor --install-extension *"
      ],
      "powershell": [
        "code --install-extension *"
      ],
      "command_regex": [
        "^(code|code-insiders|codium|cursor|windsurf) --install-extension\\b"
      ],
      "write": [
        ".mcp.json",
        "**/.mcp.json",
        ".vscode/mcp.json",
        ".cursor/mcp.json"
      ],
      "native": {
        "claude": [
          "Bash(dangerouslyDisableSandbox:true)"
        ],
        "gemini": [
          {
            "toolName": "*",
            "mcpName": "*"
          }
        ]
      }
    },
    {
      "id": "C-HITL-08",
      "effect": "ask",
      "summary": "Dumping the process environment",
      "shell": [
        "env",
        "printenv*"
      ],
      "powershell": [
        "Get-ChildItem Env:*"
      ]
    },
    {
      "id": "C-HITL-09",
      "effect": "ask",
      "summary": "Nested agent sessions",
      "shell": [
        "claude -p *",
        "claude --print *",
        "codex exec *",
        "gemini -p *",
        "gemini --prompt *",
        "copilot -p *",
        "cursor-agent -p *"
      ],
      "powershell": [
        "claude -p *",
        "codex exec *",
        "gemini -p *"
      ],
      "command_regex": [
        "^(claude|codex|gemini|copilot|cursor-agent|qwen|goose|opencode|aider)\\b"
      ]
    },
    {
      "id": "C-HITL-10",
      "effect": "ask",
      "summary": "Git configuration that runs a program",
      "shell": [
        "git config --global *",
        "git config --system *",
        "git -c core.fsmonitor=*",
        "git -c core.sshCommand=*",
        "git -c diff.external=*",
        "git config core.fsmonitor *",
        "git config core.sshCommand *",
        "git config diff.external *",
        "git config credential.helper *",
        "git config * credential.helper *"
      ],
      "command_regex": [
        "^git\\b.*(core\\.fsmonitor|core\\.ssh[Cc]ommand|diff\\.external|credential\\.helper|--upload-pack|--receive-pack|--config-env|ext::|reflog (expire|delete))",
        "(GIT_SSH_COMMAND|GIT_EXTERNAL_DIFF)="
      ],
      "write": [
        ".git/config",
        ".git/hooks/**"
      ],
      "native": {
        "codex": [
          {
            "pattern": [
              "git",
              [
                "-c",
                "--config-env"
              ]
            ],
            "match": [
              "git -c core.fsmonitor=./x.sh status",
              "git -c core.sshCommand=./x.sh fetch"
            ],
            "not_match": [
              "git status"
            ]
          }
        ]
      }
    },
    {
      "id": "C-NET-01",
      "effect": "allow",
      "summary": "Package registries",
      "network": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "proxy.golang.org",
        "sum.golang.org",
        "api.nuget.org",
        "pub.dev"
      ]
    },
    {
      "id": "C-NET-02",
      "effect": "allow",
      "summary": "Official documentation",
      "fetch": [
        "docs.github.com",
        "docs.python.org",
        "developer.mozilla.org",
        "nodejs.org",
        "www.typescriptlang.org",
        "go.dev",
        "pkg.go.dev",
        "doc.rust-lang.org",
        "docs.rs",
        "learn.microsoft.com",
        "dart.dev",
        "api.dart.dev",
        "en.cppreference.com",
        "code.claude.com"
      ]
    },
    {
      "id": "N-01",
      "effect": "deny",
      "summary": "Secret access",
      "shell": [
        "git credential fill*",
        "op read *",
        "op item get *",
        "vault kv get *",
        "vault read *",
        "pass show *",
        "security find-generic-password*",
        "security find-internet-password*",
        "security dump-keychain*",
        "kubectl config view * --raw*",
        "kubectl config view --raw*",
        "aws ecr get-login-password*",
        "gh auth token*",
        "gh auth status * --show-token*",
        "kubectl get secret*",
        "aws secretsmanager get-secret-value*",
        "gcloud auth print-access-token*",
        "gcloud auth print-identity-token*",
        "az account get-access-token*"
      ],
      "powershell": [
        "gh auth token*"
      ],
      "command_regex": [
        "(\\.claude\\.json|\\.codex\\/auth\\.json|\\.gemini\\/oauth_creds\\.json|\\.config\\/github-copilot|\\.vault-token)",
        "^(op (read|inject|item)|vault (kv|read)|pass show|security (find|dump)|git credential)\\b",
        "(^|[\\s=\"'])(\\./)?\\.env(\\.(?!example|sample|template)\\S+)?(\\s|$)",
        "(\\.ssh\\b|\\.aws\\/|\\.azure\\/|\\.kube\\/|\\.gnupg\\/|\\.config\\/gh\\/|\\.git-credentials|\\.netrc|\\.npmrc|\\.pypirc|\\.tfstate|\\.(pem|key|p12|pfx)\\b)"
      ],
      "read": [
        "**/.env",
        "**/.env.*",
        "**/*.env",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx",
        "**/*.jks",
        "**/*.keystore",
        "**/*.kdbx",
        "**/id_rsa",
        "**/id_dsa",
        "**/id_ecdsa",
        "**/id_ed25519",
        "**/*.tfstate",
        "**/*.tfstate.backup",
        "**/credentials.json",
        "**/client_secret*.json",
        "**/service-account*.json",
        "**/service_account*.json",
        "**/.npmrc",
        "**/.pypirc",
        "**/.netrc",
        "**/.git-credentials",
        "~/.ssh/**",
        "~/.gnupg/**",
        "~/.aws/**",
        "~/.azure/**",
        "~/.config/gcloud/**",
        "~/.kube/**",
        "~/.docker/config.json",
        "~/.config/gh/**",
        "~/.git-credentials",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.gem/credentials",
        "~/.cargo/credentials",
        "~/.cargo/credentials.toml",
        "~/.claude/.credentials.json",
        "~/.codex/auth.json",
        "~/.gemini/oauth_creds.json",
        "~/.claude.json",
        "~/.claude/history.jsonl",
        "~/.codex/history.jsonl",
        "~/.config/github-copilot/**",
        "~/.local/share/opencode/auth.json",
        "~/.config/op/**",
        "~/.vault-token",
        "~/.terraform.d/credentials.tfrc.json",
        "**/*.ppk",
        "**/*.ovpn",
        "~/.bash_history",
        "~/.zsh_history",
        "~/.local/state/zsh_history",
        "~/AppData/Roaming/Microsoft/Windows/PowerShell/PSReadLine/**",
        "~/.gitconfig.local",
        "~/.powershell.local.ps1",
        "~/.zshrc.local",
        "~/.bashrc.local",
        "**/.secrets",
        "~/Library/Keychains/**",
        "/proc/*/environ"
      ],
      "read_except": [
        "**/.env.example",
        "**/.env.sample",
        "**/.env.template"
      ],
      "native": {
        "codex": [
          {
            "pattern": [
              [
                "cat",
                "less",
                "more",
                "head",
                "tail",
                "cp",
                "base64",
                "xxd",
                "source"
              ],
              [
                ".env",
                ".env.local",
                ".env.production",
                ".env.development",
                "~/.aws/credentials",
                "~/.ssh/id_rsa",
                "~/.ssh/id_ed25519",
                "~/.git-credentials",
                "~/.netrc",
                "~/.npmrc",
                "~/.pypirc",
                "~/.docker/config.json",
                "~/.kube/config"
              ]
            ],
            "match": [
              "cat .env",
              "cp ~/.ssh/id_rsa /tmp/key"
            ],
            "not_match": [
              "cat .env.example"
            ]
          },
          {
            "pattern": [
              [
                "cat",
                "less",
                "more",
                "head",
                "tail",
                "cp",
                "base64",
                "xxd"
              ],
              [
                "~/.claude.json",
                "~/.claude/.credentials.json",
                "~/.codex/auth.json",
                "~/.gemini/oauth_creds.json",
                "~/.config/github-copilot/apps.json",
                "~/.config/github-copilot/hosts.json",
                "~/.vault-token"
              ]
            ],
            "match": [
              "cat ~/.claude.json",
              "cp ~/.codex/auth.json /tmp/a"
            ],
            "not_match": [
              "cat README.md"
            ]
          }
        ],
        "gemini": [
          {
            "toolName": "run_shell_command",
            "commandRegex": ".*[^\\w.-]\\.env(\\.(?!example|sample|template)[\\w-]|[^\\w.-]|$)"
          }
        ]
      }
    },
    {
      "id": "N-03",
      "effect": "deny",
      "summary": "Privilege escalation and host modification",
      "shell": [
        "sudo *",
        "su *",
        "doas *",
        "pkexec *",
        "crontab *",
        "runas *",
        "gsudo *",
        "schtasks /create*",
        "launchctl load *",
        "launchctl bootstrap *",
        "systemctl enable *",
        "systemctl --user enable *"
      ],
      "powershell": [
        "sudo *",
        "gsudo *",
        "runas *",
        "Start-Process * -Verb RunAs*",
        "Register-ScheduledTask *",
        "New-Service *",
        "schtasks /create*"
      ],
      "command_regex": [
        "^(sudo|su|doas|pkexec|crontab|runas|gsudo|schtasks|Register-ScheduledTask|New-Service)\\b",
        "(>>?|\\btee\\b.*)\\s*(~|\\$HOME)\\/\\.(bashrc|bash_profile|zshrc|zprofile|zshenv|profile)\\b"
      ],
      "write": [
        "~/.bashrc",
        "~/.bash_profile",
        "~/.zshrc",
        "~/.zprofile",
        "~/.profile",
        "~/.zshenv",
        "~/.zlogin",
        "~/.bash_login",
        "~/.bash_logout",
        "~/.config/fish/config.fish",
        "~/Library/LaunchAgents/**",
        "~/.config/systemd/user/**",
        "~/.config/autostart/**",
        "~/Documents/PowerShell/**",
        "~/.config/powershell/**",
        "~/.ssh/**",
        "~/.gitconfig",
        "/etc/**",
        "/usr/**"
      ],
      "native": {
        "codex": [
          {
            "pattern": [
              [
                "crontab",
                "launchctl"
              ]
            ],
            "match": [
              "crontab -e",
              "launchctl load agent.plist"
            ]
          }
        ]
      }
    },
    {
      "id": "N-04",
      "effect": "deny",
      "summary": "Disabling guardrails",
      "shell": [
        "* --dangerously-skip-permissions*",
        "* --allow-dangerously-skip-permissions*",
        "* --permission-mode bypassPermissions*",
        "* --permission-mode=bypassPermissions*",
        "* --dangerously-bypass-approvals-and-sandbox*",
        "* --yolo*",
        "* --approval-mode yolo*",
        "* --approval-mode=yolo*",
        "* --trust-all-tools*",
        "* --allow-all-tools*",
        "* danger-full-access*",
        "git * --no-verify*",
        "git commit -n*",
        "git -c core.hooksPath*",
        "git config core.hooksPath *",
        "git config * core.hooksPath *",
        "git config --unset* core.hooksPath*",
        "git config unset core.hooksPath*"
      ],
      "powershell": [
        "Set-MpPreference *",
        "Add-MpPreference *",
        "* --dangerously-skip-permissions*",
        "* --yolo*",
        "* --dangerously-bypass-approvals-and-sandbox*",
        "git * --no-verify*"
      ],
      "command_regex": [
        "--no-verify\\b|core\\.hooks[Pp]ath",
        "(--dangerously-skip-permissions|--dangerously-bypass-approvals-and-sandbox|--yolo|--trust-all-tools|--allow-all-tools|danger-full-access|bypassPermissions)",
        "^(Set-MpPreference|Add-MpPreference)\\b",
        "(ANTHROPIC_BASE_URL|OPENAI_BASE_URL|GOOGLE_GEMINI_BASE_URL)="
      ],
      "write": [
        "~/.claude/settings.json",
        "~/.codex/config.toml",
        "~/.gemini/settings.json"
      ],
      "native": {
        "codex": [
          {
            "pattern": [
              "git",
              [
                "commit",
                "push",
                "merge",
                "rebase"
              ],
              "--no-verify"
            ],
            "match": [
              "git commit --no-verify -m wip",
              "git push --no-verify"
            ]
          },
          {
            "pattern": [
              "git",
              "config",
              [
                "--local",
                "--global",
                "--system",
                "--worktree",
                "--unset",
                "--unset-all",
                "--add",
                "--replace-all",
                "set",
                "unset"
              ],
              [
                "core.hooksPath",
                "core.hookspath"
              ]
            ],
            "match": [
