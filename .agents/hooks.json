{
  "permission-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/permission-guard.py --format antigravity",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
